# Copy to .env.local for local dev. Never commit real values.
DATABASE_URL=postgresql://user:password@localhost:5432/tilo
# Production pool: point at your pooler URL and cap connections per instance
# so 2+ web replicas never exhaust Postgres (each instance holds this many):
# DATABASE_URL=postgresql://user:password@host:5432/tilo?connection_limit=5&pool_timeout=20
# Neon (serverless Postgres) — create a project at neon.tech, copy the
# "connection string" and append ?sslmode=require so Prisma can connect:
# DATABASE_URL=postgresql://user:password@ep-XXXX.ap-southeast-1.aws.neon.tech/tilo?sslmode=require
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Optional: separate secret for account-free order tracking links. Falls back to
# BETTER_AUTH_SECRET when unset; changing either invalidates old links.
# ORDER_TRACKING_SECRET=change-me-too
# Optional: comma-separated extra trusted origins (previews, custom domains)
# BETTER_AUTH_TRUSTED_ORIGINS=https://tilza.org
# --- Platform owner (optional) ---
# Every new sign-up is a plain `user` running their OWN shop, isolated by the
# userId columns on customers/orders/store/automations/notifications. Set this
# to the account that should be the platform operator: it is promoted to `admin`
# at sign-up and is the only role that can open /dashboard/admin (the
# cross-account monitor) and /api/admin/users. Leave it blank and no one is an
# admin — shops still work, the monitor is simply unreachable.
# ADMIN_EMAIL=you@example.com
# Optional: invite-code gate on sign-up. When set, sign-ups that are not from a
# fully-verified email (i.e. not Google) must submit this exact code or be
# rejected. Pair with NEXT_PUBLIC_SIGNUP_INVITE=true if the form shows the field.
# SIGNUP_INVITE_CODE=share-this-code-with-customers
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: only for an external API origin (defaults to same-origin /api)
# NEXT_PUBLIC_API_URL=https://api.example.com
# Set to true in production to allow search indexing
# SEO_INDEXABLE=false

# --- Email (optional) ---
# Password-reset link for credential accounts. Set EMAIL_PROVIDER=resend +
# RESEND_API_KEY to enable; otherwise reset links are never sent.
# EMAIL_PROVIDER=none
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM=Tilza <no-reply@yourdomain.com>
# Shared secret for the scheduled weekly merchant digest and dispatch-sweep
# endpoints. Dispatch also runs in-process every 20 seconds.
# CRON_SECRET=generate-a-long-random-string

# --- Web Push (optional) ---
# Generate once with `npx web-push generate-vapid-keys`; keep both keys stable.
# VAPID_PUBLIC_KEY=public-key-from-web-push
# VAPID_PRIVATE_KEY=private-key-from-web-push
# VAPID_SUBJECT=mailto:no-reply@yourdomain.com

# --- Paystack (optional) ---
# Card payments for orders. Routes return 503 until the secret key is set.
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
# Where Paystack sends the customer after checkout. Default: this app's own
# /payments/return page, which verifies the charge on arrival (good enough to
# ship). Set this only to route customers somewhere bespoke.
# PAYSTACK_CALLBACK_URL=https://yourdomain.com/payments/return

# --- Google OAuth (optional) ---
# Google is the sign-in / sign-up identity. Get an OAuth client from Google
# Cloud Console (Authorized redirect URI:
# https://<yourdomain>/api/auth/callback/google). Both keys must be set, plus
# NEXT_PUBLIC_GOOGLE_AUTH=true, or the Google buttons stay hidden.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_GOOGLE_AUTH=false
