# Copy to .env.local for local dev. Never commit real values.
DATABASE_URL=postgresql://user:password@localhost:5432/tilo
# Neon (serverless Postgres) — create a project at neon.tech, copy the
# "connection string" and append ?sslmode=require so Prisma can connect:
# DATABASE_URL=postgresql://user:password@ep-XXXX.ap-southeast-1.aws.neon.tech/tilo?sslmode=require
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Optional: comma-separated extra trusted origins (previews, custom domains)
# BETTER_AUTH_TRUSTED_ORIGINS=https://tilo.vercel.app
# Optional: owner account. The first user whose verified phone (or email)
# matches these becomes admin.
# ADMIN_EMAIL=you@example.com
# ADMIN_PHONE=+233241234567
# Optional: invite-code gate on sign-up. When set, phone-first sign-ups must
# submit this exact code or be rejected (Google/email-verified identities are
# exempt). Pair with NEXT_PUBLIC_SIGNUP_INVITE=true so the form shows the field.
# SIGNUP_INVITE_CODE=share-this-code-with-customers
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: only for an external API origin (defaults to same-origin /api)
# NEXT_PUBLIC_API_URL=https://api.example.com
# Set to true in production to allow search indexing
# SEO_INDEXABLE=false

# --- Automations ---
# Secret for external schedulers hitting /api/cron/rules + /api/cron/weekly-summary
# (e.g. cron-job.org or GitHub Actions POST: https://<host>/api/cron/rules with
# `Authorization: Bearer <CRON_SECRET>`). Recommend >= 16 random chars.
# CRON_SECRET=change-me-to-a-long-random-string
# SMS provider: arkesel | none
SMS_PROVIDER=none
# Arkesel (recommended for Ghana) — https://arkesel.com
# Generate an API key in the Arkesel dashboard.
# ARKESEL_API_KEY=your-arkesel-api-key
# Approved sender ID shown to recipients.
# ARKESEL_SENDER_ID=TILO
# Phone that receives the daily brief + weekly pulse summary (E.164, e.g. +233241234567)
# SMS_SUMMARY_RECIPIENT=+233241234567
# Cost of one Arkesel credit in pesewas, for the dashboard estimate (default 5)
# SMS_COST_PER_CREDIT_PESEWAS=5

# --- Email (optional) ---
# Phone SMS is the primary verification + password-reset channel; email is a
# secondary reset link. Set EMAIL_PROVIDER=resend + RESEND_API_KEY to enable.
# EMAIL_PROVIDER=none
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM=Tilo <no-reply@yourdomain.com>

# --- Paystack (optional) ---
# Card payments for orders. Routes return 503 until the secret key is set.
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
# Where Paystack sends the customer after checkout. Default: this app's own
# /payments/return page, which verifies the charge on arrival (good enough to
# ship). Set this only to route customers somewhere bespoke.
# PAYSTACK_CALLBACK_URL=https://yourdomain.com/payments/return

# --- Google OAuth (optional) ---
# Let users pick "sign in with Google" instead of phone + SMS. Get an OAuth
# client from Google Cloud Console (Authorized redirect URI:
# https://<yourdomain>/api/auth/callback/google). Both keys must be set, plus
# NEXT_PUBLIC_GOOGLE_AUTH=true, or the Google buttons stay hidden.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_GOOGLE_AUTH=false
# Shows the "Invite code" field on the sign-up form. Set together with the
# SIGNUP_INVITE_CODE secret to gate phone-first sign-ups.
# NEXT_PUBLIC_SIGNUP_INVITE=false
