{
  "name": "tilza",
  "version": "0.1.0",
  "private": true,
  "description": "Tilza — a hosted shop page with categories, photos and a basket customers order from",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "prestart": "node scripts/boot-migrate.mjs",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:postgres": "node --test \"tests/integration/**/*.test.mjs\"",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/db-migrate-deploy.mjs",
    "db:studio": "prisma studio",
    "seed:e2e": "node scripts/seed-e2e.mjs",
    "ads:generate": "node scripts/generate-ads.mjs",
    "vault:restore": "node scripts/vault-restore.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.0",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@t3-oss/env-nextjs": "0.13.11",
    "better-auth": "1.6.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "16.6.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.500.0",
    "next": "16.4.0",
    "prisma": "6.19.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.77.0",
    "sonner": "2.0.7",
    "tailwind-merge": "2.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.13.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.0.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.5.4",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "esbuild": "^0.28.1",
    "deepmerge-ts": "^8.0.0"
  }
}
