// Tilo app code.
// Storefront catalog: a store with the items it sells — products or services.
// One store per signed-up account (`userId` is unique), so every catalogue,
// promotion, image and social row hangs off an owner and is unreachable from
// another shop. The public page at /store/[slug] is the "Jumia" face: customers
// browse and order on WhatsApp from the item's chat button.

enum StoreItemKind {
  PRODUCT
  SERVICE
}

enum SocialPlatform {
  TIKTOK
  INSTAGRAM
  FACEBOOK_PAGE
  WHATSAPP_STATUS
}

enum SocialPostStatus {
  SHARED
  PUBLISHED
}

// How a promotion takes money off. PERCENT = % of the item price,
// FIXED = an exact amount in cedis (stored in pesewas).
enum PromotionKind {
  PERCENT
  FIXED
}

model Store {
  id           String            @id @default(cuid())
  // Owning account. Unique — one storefront per sign-up, and the ownership key
  // every catalogue route resolves through before touching a child row.
  userId       String            @unique
  name         String
  slug         String            @unique
  tagline      String?
  description  String?
  // Number the WhatsApp order buttons deep-link to. Local Ghana format.
  contactPhone String?
  active       Boolean           @default(true)
  // Announcement headline shown above the catalog on the storefront
  // (e.g. "Mid-sem sale — use code STUDENT10"). Empty = no banner.
  promoBanner  String?
  // Owner-chosen colour theme preset key (see src/lib/theme.ts). Controls the
  // whole platform surface for this workspace — dashboard shell and public
  // storefront — by seeding --brand-h/c/l in globals.css. Validated client-side
  // against ThemeKey; stored as a plain string so unknown keys degrade to the
  // default gold seed rather than crashing the page.
  theme        String            @default("gold")
  // Owner-chosen layout/appearance preset key (see src/lib/theme.ts). Picks the
  // storefront arrangement: "vibrant" is the loud yellow-black look, while
  // "professional" is the clean business layout. Stored as a plain string; the
  // UI falls back to the default when the value is unknown.
  appearance   String            @default("professional")
  // Store logo, stored in Postgres so it survives Render's ephemeral disk.
  // Served by /api/public/store/[slug]/logo (no object storage needed).
  logo         Bytes?
  logoMime     String?
  // Auto-posting cadence: how many days between generated batches. Null = the
  // automation is off (the owner has never turned it on, or turned it off).
  autoPostDays Int?
  // When the last batch was generated — drives "next post in N days" and the
  // due check. Null = never run.
  autoPostLastAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        StoreItem[]
  posts        StorePost[]
  promotions   Promotion[]
  categories   ProductCategory[]
  socials      SocialAccount[]

  @@index([slug])
}

// A social network the owner has connected, i.e. one of the icons they tap to
// post. One row per platform per shop — the account is identified by its
// handle, and auto-posting writes one draft per connected network.
model SocialAccount {
  id        String         @id @default(cuid())
  storeId   String
  platform  SocialPlatform
  // The owner's handle or page name on that network ("@ama.kente"). Carried on
  // the card so they know which account a draft is destined for.
  handle    String
  // Optional profile link, surfaced as "open profile" next to the share icon.
  url       String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, platform])
  @@index([storeId])
}

// A shelf heading inside one store's catalogue — "Beads", "Wall art", "Custom
// orders". Reached through the store rather than owning a userId of its own,
// so a guessed cuid cannot resolve against another shop (same rule as
// StoreItem / Promotion / StorePost). Items point at their category with a
// nullable FK, so a category delete orphans its items instead of taking the
// products with it.
model ProductCategory {
  id        String      @id @default(cuid())
  storeId   String
  name      String
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     StoreItem[]

  @@index([storeId])
}

model StoreItem {
  id                    String           @id @default(cuid())
  storeId               String
  // Shelf heading this product sits under. Null = uncategorised (every item
  // that predates categories lands here, and the storefront groups those
  // under their own bucket rather than hiding them). SetNull on delete so
  // removing a category never removes the products in it.
  categoryId            String?
  kind                  StoreItemKind    @default(PRODUCT)
  name                  String
  description           String?
  pricePesewas          Int
  // What it costs the workspace to deliver/source this item, in pesewas.
  // Optional — used by the owner's Intelligence dashboard to compute gross
  // profit per unit and overall margins. Never exposed on the public storefront.
  costPricePesewas      Int?
  // Original "was" price in pesewas. When set higher than pricePesewas the
  // storefront shows it struck through with an auto "+X% off" badge.
  compareAtPricePesewas Int?
  sortOrder             Int              @default(0)
  active                Boolean          @default(true)
  // Item photo, stored in Postgres so it survives Render's ephemeral disk.
  // Served by /api/public/store/items/[itemId]/image.
  image                 Bytes?
  imageMime             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  store                 Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category              ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  posts                 StorePost[]
  orderLines            OrderLineItem[]

  @@index([storeId])
  @@index([categoryId])
}

model StorePost {
  id          String           @id @default(cuid())
  storeId     String
  itemId      String
  platform    SocialPlatform
  status      SocialPostStatus @default(SHARED)
  caption     String
  externalUrl String?
  // True when the schedule drafted this row instead of the owner pressing
  // Share by hand. Pending auto drafts live in the Auto-posts panel; once
  // marked posted they join the ordinary history like any other push.
  auto        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  item        StoreItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([itemId])
}

// A sale or discount code the owner can switch on/off. Customers see live
// promotions on the storefront as "Today's offers" and quote the code (if any)
// in the WhatsApp order chat — orders themselves are confirmed off-platform.
model Promotion {
  id                 String        @id @default(cuid())
  storeId            String
  // Label customers see on the storefront, e.g. "Mid-Sem Sale".
  name               String
  // Optional code customers quote in chat ("STUDENT10"). Blank = store-wide,
  // no code needed.
  code               String?
  kind               PromotionKind
  // PERCENT: points (1-100). FIXED: cedis off, in pesewas.
  value              Int
  // Minimum order subtotal to qualify (pesewas). Null = any order.
  minSubtotalPesewas Int?
  active             Boolean       @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  // Optional banner artwork, stored in Postgres like logos and item photos.
  // Served by /api/public/store/promotions/[promoId]/image.
  image              Bytes?
  imageMime          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  store              Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, active])
}
