// User feedback and problem reports: what a shop owner or a shopper tells Tilza
// in words, as opposed to what the telemetry ledger (telemetry.prisma) infers
// from crashes. Ingested by the public POST /api/feedback route (or the
// /feedback page) and triaged in the admin Feedback panel.
//
// `userId` is nullable on purpose: a shopper on a storefront has no account, so
// platform-level reports are filed with no owner and still reach the operator.
// Datasource + generator live in _base.prisma.

enum FeedbackKind {
  BUG
  COMPLAINT
  PRAISE
  SUGGESTION
  OTHER
}

enum FeedbackStatus {
  NEW
  SEEN
  RESOLVED
}

model Feedback {
  id         String         @id @default(cuid())
  // Shop the reporter was using. Null = the platform itself, not one shop.
  userId     String?
  storeId    String?
  customerId String?
  kind       FeedbackKind   @default(OTHER)
  // Optional 1–5 rating alongside the written message.
  rating     Int?
  message    String
  // Page path or shop slug they were on when they wrote it.
  page       String?
  email      String?
  userAgent  String?
  status     FeedbackStatus @default(NEW)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  store      Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  // Set when the report came from a known contact on a shop.
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
}
