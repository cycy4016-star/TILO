// Tilo customer and order workspace models.
//
// TENANCY: every row is owned by the signed-up account that created it. The
// `userId` column is the isolation boundary — API routes filter on it so one
// shop can never read or write another shop's rows. Orders repeat `userId`
// (rather than joining through customer) so the dashboard aggregates stay a
// single-table query.

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model Customer {
  id        String   @id @default(cuid())
  // Owning account. Set on create; every read/write filters on it.
  userId    String
  name      String
  company   String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
  events    AutomationEvent[]
  notifications Notification[]

  @@index([userId])
  @@index([userId, name])
  @@index([userId, company])
  @@index([userId, email])
  @@index([userId, phone])
  @@index([name])
  @@index([company])
  @@index([email])
  @@index([phone])
}

model Order {
  id            String      @id @default(cuid())
  // Owning account — mirrors the customer's owner, denormalized for the
  // dashboard aggregates.
  userId        String
  orderNumber   String
  customerId    String
  description   String
  status        OrderStatus @default(PENDING)
  // Payment chasing: amount in GHS pesewas (no floats), paidAt set once money lands.
  amountPesewas Int?
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  events        AutomationEvent[]
  payments      PaymentTransaction[]
  notifications Notification[]
  lines         OrderLineItem[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, paidAt])
  @@index([userId, createdAt])
  @@index([customerId])
  @@index([status])
  @@index([orderNumber])
  @@index([paidAt])
}

// A productized line on an order. The name, unit price and unit cost are
// SNAPSHOT columns: they freeze the catalog values at the moment of sale, so
// history stays accurate even if the StoreItem is later renamed, repriced, or
// deleted (storeItemId then goes null while the snapshots remain). The
// owner's Intelligence + Products dashboards read these.
model OrderLineItem {
  id             String    @id @default(cuid())
  orderId        String
  // Null once the linked StoreItem is deleted — the snapshots still tell the story.
  storeItemId    String?
  name           String
  unitPricePesewas Int
  // Cost per unit at sale time (copied from costPricePesewas). Null if unset.
  unitCostPesewas Int?
  quantity       Int       @default(1)
  createdAt      DateTime  @default(now())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeItem      StoreItem? @relation(fields: [storeItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([storeItemId])
}
