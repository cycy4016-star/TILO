enum UserAudienceKind {
  OWNER
  COURIER
  SHOPPER
}

model UserAudience {
  id        String           @id @default(cuid())
  userId    String
  kind      UserAudienceKind
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([kind, createdAt])
  @@map("user_audience")
}
